    private void jTable1MousePressed(java.awt.event.MouseEvent evt) {                                     
     jtxtID.setText(jTable1.getValueAt(jTable1.getSelectedRow(), 0).toString());
     jtxtNombre.setText(jTable1.getValueAt(jTable1.getSelectedRow(), 1).toString());
     jtxtDescripcion.setText(jTable1.getValueAt(jTable1.getSelectedRow(), 2).toString());
     jtxtTelefono.setText(jTable1.getValueAt(jTable1.getSelectedRow(), 3).toString());
     jtxtRuc.setText(jTable1.getValueAt(jTable1.getSelectedRow(), 4).toString());
    }                                    

    private void jbtnNuevoActionPerformed(java.awt.event.ActionEvent evt) {                                          
    limpiarCajas();
    }                                         

    private void jbtnEditarActionPerformed(java.awt.event.ActionEvent evt) {                                           
    int fila = jTable1.getSelectedRow();
    
    if (fila >=0){
         modelo.setValueAt(jtxtID.getText(),fila, 0);
         modelo.setValueAt(jtxtNombre.getText(),fila, 1);
         modelo.setValueAt(jtxtDescripcion.getText(),fila, 2);
         modelo.setValueAt(jtxtTelefono.getText(),fila, 3);
         modelo.setValueAt(jtxtRuc.getText(),fila, 4);
    }
    else {
        JOptionPane.showMessageDialog(null, "Seleccione un Registro", "Error", JOptionPane.ERROR_MESSAGE);
    }
    limpiarCajas();
    }                                          

    private void jbtnInformeActionPerformed(java.awt.event.ActionEvent evt) {                                            
    MessageFormat Header = new MessageFormat("Registro de Contacto");
    MessageFormat footer = new MessageFormat("Página {0}");
    
    try{
        PrintRequestAttributeSet set = new HashPrintRequestAttributeSet();
        set.add(OrientationRequested.LANDSCAPE);
        jTable1.print(JTable.PrintMode.FIT_WIDTH, Header, footer, true, set, true);
        JOptionPane.showMessageDialog(null, "\nImpreso con éxito");
    }
    catch (java.awt.print.PrinterException e) {
        JOptionPane.showMessageDialog(null, "\nFallido\n"+e);
    }
    }                                           

    private void jbtnCancelarActionPerformed(java.awt.event.ActionEvent evt) {                                             
    System.exit(0);
    }                                            

    private void jbtnEliminarActionPerformed(java.awt.event.ActionEvent evt) {                                             
    int fila = jTable1.getSelectedRow();
    
    if (fila >= 0) {
        modelo.removeRow(fila);
        JOptionPane.showMessageDialog(null, "Registro Eliminado", "Mensaje", JOptionPane.INFORMATION_MESSAGE);
        limpiarCajas();
    } 
    else {
        JOptionPane.showMessageDialog(null, "Seleccione un Registro para eliminar", "Error", JOptionPane.ERROR_MESSAGE);
    }
    }                                            

    private void jbtnGuardarActionPerformed(java.awt.event.ActionEvent evt) {                                            
     modelo.addRow(new Object[]{
     jtxtID.getText(),
     jtxtNombre.getText(),
     jtxtDescripcion.getText(),
     jtxtTelefono.getText(),
     jtxtRuc.getText()
    });
    limpiarCajas();
    }                                           

